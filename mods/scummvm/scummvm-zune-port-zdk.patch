+#ifndef BACKENDS_GRAPHICS_ZUNE_H
+#define BACKENDS_GRAPHICS_ZUNE_H
+
+#include "backends/graphics/graphics.h"
+#include "graphics/surface.h"
+
+// Zune HD display: portrait 272x480 ARGB front buffer, played in landscape 480x272.
+// Game screen (CLUT8) is nearest-scaled into the landscape view, rotated into the buffer,
+// then pushed to the kernel-owned front buffer with lyra_kcall in small chunks.
+class ZuneGraphicsManager : public GraphicsManager {
+public:
+	enum { LAND_W = 480, LAND_H = 272, FB_W = 272, FB_H = 480 };
+
+	ZuneGraphicsManager();
+	virtual ~ZuneGraphicsManager();
+
+	bool hasFeature(OSystem::Feature f) const override { return f == OSystem::kFeatureCursorPalette; }
+	void setFeatureState(OSystem::Feature f, bool enable) override { if (f == OSystem::kFeatureCursorPalette) _cursorPaletteOn = enable; }
+	bool getFeatureState(OSystem::Feature f) const override { return f == OSystem::kFeatureCursorPalette && _cursorPaletteOn; }
+
+	const OSystem::GraphicsMode *getSupportedGraphicsModes() const override;
+	int getDefaultGraphicsMode() const override { return 0; }
+	bool setGraphicsMode(int mode) override { return true; }
+	void resetGraphicsScale() override {}
+	int getGraphicsMode() const override { return 0; }
+#ifdef USE_RGB_COLOR
+	Graphics::PixelFormat getScreenFormat() const override { return Graphics::PixelFormat::createFormatCLUT8(); }
+	Common::List<Graphics::PixelFormat> getSupportedFormats() const override;
+#endif
+	void initSize(uint width, uint height, const Graphics::PixelFormat *format = NULL) override;
+	int getScreenChangeID() const override { return _changeId; }
+
+	void beginGFXTransaction() override {}
+	OSystem::TransactionError endGFXTransaction() override { return OSystem::kTransactionSuccess; }
+
+	int16 getHeight() const override { return _h; }
+	int16 getWidth() const override { return _w; }
+	void setPalette(const byte *colors, uint start, uint num) override;
+	void grabPalette(byte *colors, uint start, uint num) const override;
+	void copyRectToScreen(const void *buf, int pitch, int x, int y, int w, int h) override;
+	Graphics::Surface *lockScreen() override { return &_surf; }
+	void unlockScreen() override { _dirty = true; }
+	void fillScreen(uint32 col) override;
+	void updateScreen() override;
+	void setShakePos(int shakeOffset) override { _shake = shakeOffset; _dirty = true; }
+	void setFocusRectangle(const Common::Rect &rect) override {}
+	void clearFocusRectangle() override {}
+
+	void showOverlay() override { _ovlOn = true; _dirty = true; }
+	void hideOverlay() override { _ovlOn = false; _dirty = true; }
+	Graphics::PixelFormat getOverlayFormat() const override { return Graphics::PixelFormat(2, 5, 6, 5, 0, 11, 5, 0, 0); }
+	void clearOverlay() override;
+	void grabOverlay(void *buf, int pitch) const override;
+	void copyRectToOverlay(const void *buf, int pitch, int x, int y, int w, int h) override;
+	int16 getOverlayHeight() const override { return LAND_H; }
+	int16 getOverlayWidth() const override { return LAND_W; }
+
+	bool showMouse(bool visible) override { bool o = _curVis; _curVis = visible; _dirty = true; return o; }
+	void warpMouse(int x, int y) override { _mx = x; _my = y; _dirty = true; }
+	void setMouseCursor(const void *buf, uint w, uint h, int hotspotX, int hotspotY, uint32 keycolor, bool dontScale = false, const Graphics::PixelFormat *format = NULL) override;
+	void setCursorPalette(const byte *colors, uint start, uint num) override;
+
+	// PaletteManager is declared by GraphicsManager's base; setPalette/grabPalette above implement it.
+
+	// Landscape pixel (0..479, 0..271) -> coordinates in the current mouse space (overlay or game).
+	void landscapeToMouse(int lx, int ly, int &mx, int &my) const;
+	void setMouse(int x, int y) { _mx = x; _my = y; _dirty = true; }
+
+private:
+	void render();
+	void drawHints();
+	void push(int rowMin, int rowMax);
+	void pushGl();
+
+	Graphics::Surface _surf;
+	byte _pal[256 * 3];
+	uint32 _palArgb[256];
+	uint16 *_ovl;
+	bool _ovlOn, _dirty, _curVis, _cursorPaletteOn;
+	int _w, _h, _changeId, _shake;
+	int _mx, _my;
+	byte *_cur; int _cw, _ch, _chx, _chy; uint32 _ckey;
+	byte _cpal[256 * 3]; uint32 _cpalArgb[256];
+	int _offX, _dispW;        // game view inside the landscape screen
+	uint32 *_frame;           // FB_W*FB_H staged ARGB
+	uint32 _lastPush;         // GetTickCount of the last push to the front buffer
+};
+
+#endif
diff --git a/backends/platform/zune/zune.cpp b/backends/platform/zune/zune.cpp
new file mode 100644
index 0000000000..ade5e00704
--- /dev/null
+++ b/backends/platform/zune/zune.cpp
@@ -0,0 +1,692 @@
+// ScummVM backend for the Zune HD, running as a Lyra plugin DLL inside the daemon (nativeapp.exe).
+// Hardware paths (all proven by spikes): framebuffer write via lyra_kcall, touch read from servicesd's
+// ci3 ring, audio via WaveOut. WinCE ignores CreateThread stack sizes (64KB), so engine code runs on a
+// private VirtualAlloc'ed stack via call_on_stack().
+#define FORBIDDEN_SYMBOL_ALLOW_ALL
+
+#include "common/scummsys.h"
+
+#if defined(USE_ZUNE_DRIVER)
+
+#include <windows.h>
+#include <mmsystem.h>
+extern "C" {
+#include "backends/platform/zune/lyra.h"
+}
+#include "backends/platform/zune/zdk.h"
+
+#include "backends/modular-backend.h"
+#include "base/main.h"
+#include "backends/saves/default/default-saves.h"
+#include "backends/timer/default/default-timer.h"
+#include "backends/events/default/default-events.h"
+#include "backends/mutex/mutex.h"
+#include "backends/fs/windows/windows-fs-factory.h"
+#include "backends/platform/zune/zune-graphics.h"
+#include "audio/mixer_intern.h"
+#include "common/events.h"
+#include "common/queue.h"
+#include "common/config-manager.h"
+
+// ---- private stacks --------------------------------------------------------------------------
+extern "C" void *call_on_stack(void *(*fn)(void *), void *arg, void *stack_top);
+__asm__(
+".text\n.code 32\n.align 2\n.global call_on_stack\ncall_on_stack:\n"
+"  stmfd sp!, {r4, r5, lr}\n"
+"  mov r4, sp\n"
+"  mov sp, r2\n"
+"  mov r3, r0\n"
+"  mov r0, r1\n"
+"  mov lr, pc\n"
+"  mov pc, r3\n"
+"  mov sp, r4\n"
+"  ldmfd sp!, {r4, r5, lr}\n"
+"  mov pc, lr\n");
+
+struct StackJob { void *(*fn)(void *); void *arg; byte *blk; DWORD size; };
+
+static DWORD WINAPI stackThread(LPVOID p) {
+	StackJob *j = (StackJob *)p;
+	call_on_stack(j->fn, j->arg, j->blk + j->size - 16);
+	return 0;
+}
+
+static HANDLE startStackThread(void *(*fn)(void *), void *arg, DWORD stackBytes) {
+	StackJob *j = new StackJob;
+	j->fn = fn; j->arg = arg; j->size = stackBytes;
+	j->blk = (byte *)VirtualAlloc(NULL, stackBytes, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+	if (!j->blk) return NULL;
+	return CreateThread(NULL, 0, stackThread, j, 0, NULL);
+}
+
+// ---- libc gaps in the CE runtime ----------------------------------------------------------------
+static void toWide(const char *s, WCHAR *w, int cap) { MultiByteToWideChar(CP_ACP, 0, s, -1, w, cap); }
+extern "C" int remove(const char *path) { WCHAR w[MAX_PATH]; toWide(path, w, MAX_PATH); return DeleteFileW(w) ? 0 : -1; }
+extern "C" int rename(const char *a, const char *b) { WCHAR wa[MAX_PATH], wb[MAX_PATH]; toWide(a, wa, MAX_PATH); toWide(b, wb, MAX_PATH); return MoveFileW(wa, wb) ? 0 : -1; }
+
+bool isSmartphone() { return false; }   // referenced by engines/engine.cpp for _WIN32_WCE
+
+// ---- globals ----------------------------------------------------------------------------------
+static HANDLE g_stop = NULL;
+static volatile bool g_quit = false;
+
+static void zlog(const char *msg) {
+	HANDLE h = CreateFileW(L"\\flash2\\scummvm\\scummvm.log", GENERIC_WRITE, FILE_SHARE_READ, NULL, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+	if (h == INVALID_HANDLE_VALUE) return;
+	SetFilePointer(h, 0, NULL, FILE_END);
+	DWORD n; WriteFile(h, msg, (DWORD)strlen(msg), &n, NULL);
+	CloseHandle(h);
+}
+
+// CE has no current directory; our paths are always fully qualified, so plain fopen is enough.
+extern "C" FILE *wce_fopen(const char *fname, const char *fmode) { return fopen(fname, fmode); }
+
+// ---- mutexes ----------------------------------------------------------------------------------
+class ZuneMutexManager : public MutexManager {
+public:
+	OSystem::MutexRef createMutex() override {
+		CRITICAL_SECTION *cs = new CRITICAL_SECTION;
+		InitializeCriticalSection(cs);
+		return (OSystem::MutexRef)cs;
+	}
+	void lockMutex(OSystem::MutexRef m) override { EnterCriticalSection((CRITICAL_SECTION *)m); }
+	void unlockMutex(OSystem::MutexRef m) override { LeaveCriticalSection((CRITICAL_SECTION *)m); }
+	void deleteMutex(OSystem::MutexRef m) override { DeleteCriticalSection((CRITICAL_SECTION *)m); delete (CRITICAL_SECTION *)m; }
+};
+
+// ---- the system -------------------------------------------------------------------------------
+class OSystem_Zune : public ModularBackend, Common::EventSource {
+public:
+	OSystem_Zune();
+	virtual ~OSystem_Zune();
+
+	void initBackend() override;
+	Common::EventSource *getDefaultEventSource() override { return this; }
+	bool pollEvent(Common::Event &event) override;
+	uint32 getMillis(bool skipRecord = false) override { return GetTickCount() - _t0; }
+	void delayMillis(uint msecs) override { Sleep(msecs); }
+	void getTimeAndDate(TimeDate &t) const override;
+	void logMessage(LogMessageType::Type type, const char *message) override { zlog(message); }
+
+	void pushEvent(const Common::Event &e);
+	void pushKey(Common::KeyCode code, int ascii, int flags);
+	ZuneGraphicsManager *gfx() { return (ZuneGraphicsManager *)_graphicsManager; }
+
+	void touchLoop();
+	void touchLoopRing();
+	void audioLoop();
+	void timerLoop();
+
+private:
+	DWORD _t0;
+	CRITICAL_SECTION _evCs;
+	Common::Queue<Common::Event> _events;
+	bool _sentQuit;
+};
+
+OSystem_Zune::OSystem_Zune() : _t0(GetTickCount()), _sentQuit(false) {
+	_fsFactory = new WindowsFilesystemFactory();
+	InitializeCriticalSection(&_evCs);
+}
+
+OSystem_Zune::~OSystem_Zune() {
+	// Like the stock backends: the timer/event/save managers must go before ModularBackend deletes
+	// the mutex manager they lock through g_system in their own destructors.
+	delete _timerManager;
+	_timerManager = 0;
+	delete _eventManager;
+	_eventManager = 0;
+	delete _savefileManager;
+	_savefileManager = 0;
+}
+
+void OSystem_Zune::getTimeAndDate(TimeDate &t) const {
+	SYSTEMTIME st; GetLocalTime(&st);
+	t.tm_sec = st.wSecond; t.tm_min = st.wMinute; t.tm_hour = st.wHour;
+	t.tm_mday = st.wDay; t.tm_mon = st.wMonth - 1; t.tm_year = st.wYear - 1900; t.tm_wday = st.wDayOfWeek;
+}
+
+void OSystem_Zune::pushKey(Common::KeyCode code, int ascii, int flags) {
+	Common::Event e;
+	e.kbd.keycode = code; e.kbd.ascii = ascii; e.kbd.flags = flags;
+	e.type = Common::EVENT_KEYDOWN; pushEvent(e);
+	e.type = Common::EVENT_KEYUP; pushEvent(e);
+}
+
+void OSystem_Zune::pushEvent(const Common::Event &e) {
+	EnterCriticalSection(&_evCs);
+	_events.push(e);
+	LeaveCriticalSection(&_evCs);
+}
+
+bool OSystem_Zune::pollEvent(Common::Event &event) {
+	if (g_quit && !_sentQuit) {
+		_sentQuit = true;
+		event.type = Common::EVENT_QUIT;
+		return true;
+	}
+	if (WaitForSingleObject(g_stop, 0) == WAIT_OBJECT_0) g_quit = true;
+	bool got = false;
+	EnterCriticalSection(&_evCs);
+	if (!_events.empty()) { event = _events.pop(); got = true; }
+	LeaveCriticalSection(&_evCs);
+	return got;
+}
+
+// ---- helper threads (static trampolines run on private stacks) --------------------------------
+static void *touchEntry(void *p) { ((OSystem_Zune *)p)->touchLoop(); return 0; }
+static void *audioEntry(void *p) { ((OSystem_Zune *)p)->audioLoop(); return 0; }
+static void *timerEntry(void *p) { ((OSystem_Zune *)p)->timerLoop(); return 0; }
+
+static Audio::MixerImpl *g_mixer = 0;
+static DefaultTimerManager *g_timer = 0;
+
+void OSystem_Zune::initBackend() {
+	_mutexManager = new ZuneMutexManager();
+	_timerManager = new DefaultTimerManager();
+	g_timer = (DefaultTimerManager *)_timerManager;
+	_eventManager = new DefaultEventManager(this);
+	_savefileManager = new DefaultSaveFileManager();
+	_graphicsManager = new ZuneGraphicsManager();
+	g_mixer = new Audio::MixerImpl(this, 22050);
+	_mixer = g_mixer;
+	g_mixer->setReady(true);
+
+	ModularBackend::initBackend();
+
+	startStackThread(touchEntry, this, 128 * 1024);
+	startStackThread(audioEntry, this, 512 * 1024);
+	startStackThread(timerEntry, this, 512 * 1024);
+}
+
+extern "C" void SystemIdleTimerReset(void);   // coredll: keeps the screen from timing out
+
+void OSystem_Zune::timerLoop() {
+	int ticks = 0;
+	while (!g_quit) {
+		Sleep(10);
+		g_timer->handler();
+		if (++ticks >= 300) { ticks = 0; SystemIdleTimerReset(); }   // ~every 3s
+	}
+}
+
+void OSystem_Zune::audioLoop() {
+	const int RATE = 22050, FRAMES = 2048, NBUF = 4;
+	static short bufs[NBUF][FRAMES * 2];
+	WAVEFORMATEX wf; memset(&wf, 0, sizeof wf);
+	wf.wFormatTag = WAVE_FORMAT_PCM; wf.nChannels = 2; wf.nSamplesPerSec = RATE;
+	wf.wBitsPerSample = 16; wf.nBlockAlign = 4; wf.nAvgBytesPerSec = RATE * 4;
+	HWAVEOUT h = 0;
+	MMRESULT r = waveOutOpen(&h, WAVE_MAPPER, &wf, 0, 0, CALLBACK_NULL);
+	if (r != MMSYSERR_NOERROR) { char m[64]; sprintf(m, "waveOutOpen failed %u\n", (unsigned)r); zlog(m); return; }
+	WAVEHDR hdr[NBUF]; memset(hdr, 0, sizeof hdr);
+	for (int i = 0; i < NBUF; i++) {
+		hdr[i].lpData = (LPSTR)bufs[i]; hdr[i].dwBufferLength = FRAMES * 4;
+		waveOutPrepareHeader(h, &hdr[i], sizeof(WAVEHDR));
+		hdr[i].dwFlags |= WHDR_DONE;
+	}
+	while (!g_quit) {
+		bool any = false;
+		for (int i = 0; i < NBUF; i++) {
+			if (hdr[i].dwFlags & WHDR_DONE) {
+				g_mixer->mixCallback((byte *)bufs[i], FRAMES * 4);
+				hdr[i].dwFlags &= ~WHDR_DONE;
+				waveOutWrite(h, &hdr[i], sizeof(WAVEHDR));
+				any = true;
+			}
+		}
+		if (!any) Sleep(5);
+	}
+	waveOutReset(h);
+	for (int i = 0; i < NBUF; i++) waveOutUnprepareHeader(h, &hdr[i], sizeof(WAVEHDR));
+	waveOutClose(h);
+}
+
+// ---- touch: poll servicesd's ci3 ring (read-only) and turn it into mouse events ---------------
+#define NK_PROC_LIST  0x80bee010u
+#define ZAM_CI3       0x418a7bf0u
+#define ZAM_RING_BASE (ZAM_CI3 + 0x1cu)
+
+static void kname(DWORD w, char *out, int cap) {
+	int i = 0;
+	for (; i < cap - 1 && w; i++) {
+		unsigned short ch = (unsigned short)(lyra_kreadu32(w + i * 2) & 0xffff);
+		if (!ch) break;
+		out[i] = (ch >= 'A' && ch <= 'Z') ? (char)(ch + 32) : (char)ch;
+	}
+	out[i] = 0;
+}
+
+static DWORD findPid(const char *want) {
+	DWORD head = lyra_kreadu32(NK_PROC_LIST), cur = head;
+	for (int i = 0; i < 64 && cur; i++) {
+		char nm[24]; kname(lyra_kreadu32(cur + 0x20), nm, sizeof nm);
+		if (strstr(nm, want)) return lyra_kreadu32(cur + 0x0c);
+		DWORD nxt = lyra_kreadu32(cur); if (nxt == head) break; cur = nxt;
+	}
+	return 0;
+}
+
+// ---- freeze the Zune UI (gemstone) while ScummVM owns the screen -------------------------------
+// Stops the compositor redrawing over our frames and stops the Zune UI reacting to our touches.
+// CE thread ids from toolhelp are usable as thread handles. Always thaw on exit.
+#include <tlhelp32.h>
+static DWORD g_frozen[256];
+static int g_nfrozen = 0;
+
+static void freezeUiOld();
+static void freezeUi() { if (zdkLoad() && g_zcfg.freeze) freezeUiOld(); }   // freeze=1 in zdk.ini: suspend the Zune shell while we run
+static void freezeUiOld() {
+	// The Zune UI shell is "gemstone"; while an XNA app tile is running the shell is gone and the Zune-logo
+	// loader that keeps redrawing the screen belongs to "xnalauncher". Freeze whichever of them exist.
+	DWORD pid = findPid("gemstone"), pid2 = findPid("xnalauncher"), pid3 = findPid("compositor");
+	if (pid) { pid2 = 0; pid3 = 0; }       // normal mode: the shell is running, freeze only it (buttons keep working)
+	HMODULE th = LoadLibraryW(L"toolhelp.dll");
+	if ((!pid && !pid2 && !pid3) || !th) return;
+	typedef HANDLE (WINAPI *PSnap)(DWORD, DWORD);
+	typedef BOOL (WINAPI *PThread)(HANDLE, LPTHREADENTRY32);
+	typedef BOOL (WINAPI *PClose)(HANDLE);
+	PSnap snap = (PSnap)GetProcAddress(th, L"CreateToolhelp32Snapshot");
+	PThread first = (PThread)GetProcAddress(th, L"Thread32First");
+	PThread next = (PThread)GetProcAddress(th, L"Thread32Next");
+	PClose cls = (PClose)GetProcAddress(th, L"CloseToolhelp32Snapshot");
+	if (!snap || !first || !next) return;
+	HANDLE s = snap(TH32CS_SNAPTHREAD, 0);
+	if (s == INVALID_HANDLE_VALUE) return;
+	THREADENTRY32 te; te.dwSize = sizeof te;
+	if (first(s, &te)) {
+		do {
+			if (((pid && te.th32OwnerProcessID == pid) || (pid2 && te.th32OwnerProcessID == pid2) || (pid3 && te.th32OwnerProcessID == pid3)) && g_nfrozen < 256 && SuspendThread((HANDLE)te.th32ThreadID) != (DWORD)-1)
+				g_frozen[g_nfrozen++] = te.th32ThreadID;
+		} while (next(s, &te));
+	}
+	if (cls) cls(s);
+}
+
+static void thawUi() {
+	for (int i = 0; i < g_nfrozen; i++) ResumeThread((HANDLE)g_frozen[i]);
+	g_nfrozen = 0;
+}
+
+// ---- original servicesd-ring touch reader (works while the Zune shell is frozen; ring=1 in zdk.ini) ----
+void OSystem_Zune::touchLoopRing() {
+	lyra_kernel_ensure_helpers();
+	DWORD pid = findPid("servicesd");
+	HANDLE h = pid ? OpenProcess(PROCESS_ALL_ACCESS, FALSE, pid) : NULL;
+	DWORD base = 0, rd = 0;
+	if (h) ReadProcessMemory(h, (void *)ZAM_RING_BASE, &base, 4, &rd);
+	if (!h || !base) { zlog("touch: servicesd ring not found\n"); return; }
+
+	static DWORD prev[16 * 16], cur[512 * 16];   // the ring holds up to ~448 records of 64 bytes
+	memset(prev, 0, sizeof prev);
+	bool down = false, dragging = false, rcDone = false, holdL = false;   // holdL: long press is holding the left button (CMI verb coin)
+	DWORD homeDown = 0;                      // GetTickCount when the Home button went down (0 = up)
+	int nTouch = 0, nBeat = 0;               // touch records seen; heartbeat lines logged
+	int done = 0;                            // records of the current ring fill already processed (drain mode)
+	DWORD tStart = GetTickCount(), tBeat = tStart;
+	int zone = 0;                            // 1 = top-right (Esc), 2 = top-left (menu / hold to quit)
+	const int ZONE_W = 56, ZONE_H = 44;
+	int dx = 0, dy = 0, lx = 0, ly = 0;      // down point and last point (landscape)
+	DWORD tDown = 0;
+
+	while (!g_quit) {
+		// With gemstone frozen nobody drains the ring, so we do: every record in [base, head) is new.
+		DWORD head = 0;
+		ReadProcessMemory(h, (void *)(ZAM_CI3 + 0x20u), &head, 4, &rd);
+		bool drain = g_nfrozen > 0 && head >= base && head - base <= 0x8000;   // whole ring, not just the first 1KB
+		int cnt = drain ? (int)((head - base) / 64) : 16;
+		if (cnt > 512) cnt = 512;
+		if (ReadProcessMemory(h, (void *)base, cur, (DWORD)cnt * 64, &rd)) {
+			for (int s = drain ? done : 0; s < cnt; s++) {
+				DWORD *r = cur + s * 16, *p = prev + s * 16;
+				if (!drain && !memcmp(r, p, 64)) continue;
+				if (r[0] != 3 && r[0] != 4) {            // diagnostics: any non-touch, non-accelerometer record (buttons etc.)
+					static int nl = 0;
+					if (nl < 300) { nl++; char lb[140]; sprintf(lb, "ring s=%d t=%lu w1=%lx w2=%lx w3=%lx w4=%lx w5=%lx\n", s, r[0], r[1], r[2], r[3], r[4], r[5]); zlog(lb); }
+				}
+				if (r[0] == 2 && r[1] == 1) {          // hardware button: [2]=key code, [3]: 2 = pressed, 1 = released
+					// Home (0x24): the Zune reports a press as an instant down/up pair (no hold information), so:
+					// a press = Esc (skip cutscene); a second press within 600ms also opens the global menu (Quit/Save/Load).
+					// The side button (0x74) and power (0x5f) are left to the Zune (volume / screen).
+					if (r[2] == 0x24 && r[3] == 2) {
+						DWORD now = GetTickCount();
+						pushKey(Common::KEYCODE_ESCAPE, 27, 0);
+						if (homeDown && now - homeDown < 600) { pushKey(Common::KEYCODE_F5, 0, Common::KBD_CTRL); homeDown = 0; }
+						else homeDown = now;
+					}
+					continue;
+				}
+				if (r[0] != 3) continue;
+				nTouch++;
+				DWORD ph = r[2]; int c = (int)r[5];
+				int fx = (int)(r[3] & 0xffff), fy = (int)(r[4] & 0xffff);
+				int px = fx, py = fy;                // rotate portrait touch -> landscape
+				lx = py; ly = (ZuneGraphicsManager::LAND_H - 1) - px;
+				if (lx < 0) lx = 0; if (lx >= ZuneGraphicsManager::LAND_W) lx = ZuneGraphicsManager::LAND_W - 1;
+				if (ly < 0) ly = 0; if (ly >= ZuneGraphicsManager::LAND_H) ly = ZuneGraphicsManager::LAND_H - 1;
+				Common::Event e;
+				int mx, my;
+				if (ph == 1 && c == 1) {
+					down = true; dragging = false; rcDone = false; dx = lx; dy = ly; tDown = GetTickCount();
+					// corner zones are on-screen buttons, not game input
+					zone = (ly < ZONE_H && lx >= ZuneGraphicsManager::LAND_W - ZONE_W) ? 1 : (ly < ZONE_H && lx < ZONE_W) ? 2
+						: (ly >= ZuneGraphicsManager::LAND_H - ZONE_H && lx >= ZuneGraphicsManager::LAND_W - ZONE_W) ? 3 : 0;   // 3 = bottom-right: right click (CMI inventory)
+					if (!zone) {
+						gfx()->landscapeToMouse(lx, ly, mx, my);
+						e.type = Common::EVENT_MOUSEMOVE; e.mouse.x = mx; e.mouse.y = my; pushEvent(e);
+						gfx()->setMouse(mx, my);
+					}
+				} else if (ph == 1 && c == 0 && down && zone) {
+					// zone tap (short press): top-right = Esc (skip cutscene), top-left = global menu (Ctrl+F5)
+					if (GetTickCount() - tDown < 1500) {
+						if (zone == 1) pushKey(Common::KEYCODE_ESCAPE, 27, 0);
+						else if (zone == 3) {
+							gfx()->landscapeToMouse(lx, ly, mx, my);
+							e.mouse.x = mx; e.mouse.y = my;
+							e.type = Common::EVENT_RBUTTONDOWN; pushEvent(e);
+							e.type = Common::EVENT_RBUTTONUP; pushEvent(e);
+						} else pushKey(Common::KEYCODE_F5, 0, Common::KBD_CTRL);
+					}
+					zone = 0; down = false;
+				} else if (ph == 1 && c == 0 && down) {
+					gfx()->landscapeToMouse(lx, ly, mx, my);
+					if (holdL) {                        // end of a held left button: release where the finger is
+						e.mouse.x = mx; e.mouse.y = my; e.type = Common::EVENT_LBUTTONUP; pushEvent(e);
+						holdL = false;
+					} else if (!dragging && !rcDone) {        // a tap: click now
+						e.mouse.x = mx; e.mouse.y = my;
+						e.type = Common::EVENT_LBUTTONDOWN; pushEvent(e);
+						e.type = Common::EVENT_LBUTTONUP; pushEvent(e);
+					} else if (dragging) {
+						e.mouse.x = mx; e.mouse.y = my; e.type = Common::EVENT_LBUTTONUP; pushEvent(e);
+					}
+					down = false;
+				} else if (ph == 3 && down && !zone) {
+					gfx()->landscapeToMouse(lx, ly, mx, my);
+					if (!dragging && !rcDone && (abs(lx - dx) > 12 || abs(ly - dy) > 12)) {
+						dragging = true;
+						int ox, oy; gfx()->landscapeToMouse(dx, dy, ox, oy);
+						e.mouse.x = ox; e.mouse.y = oy; e.type = Common::EVENT_LBUTTONDOWN; pushEvent(e);
+					}
+					e.type = Common::EVENT_MOUSEMOVE; e.mouse.x = mx; e.mouse.y = my; pushEvent(e);
+					gfx()->setMouse(mx, my);
+				}
+			}
+			if (!drain) memcpy(prev, cur, sizeof prev);
+			else {
+				done = cnt;
+				DWORD head2 = 0;                     // only reset when nothing new was appended meanwhile (else next pass continues)
+				ReadProcessMemory(h, (void *)(ZAM_CI3 + 0x20u), &head2, 4, &rd);
+				if (head2 == head && cnt > 0) { WriteProcessMemory(h, (void *)(ZAM_CI3 + 0x20u), &base, 4, &rd); done = 0; }   // ring drained
+			}
+		}
+		// long press without movement -> right click
+		bool holdLeft = ConfMan.hasKey("gameid") && ConfMan.get("gameid") == "comi";   // CMI: hold = left button down
+		if (down && !zone && !dragging && !rcDone && GetTickCount() - tDown > (holdLeft ? 450 : 700)) {
+			int mx, my; gfx()->landscapeToMouse(lx, ly, mx, my);
+			Common::Event e; e.mouse.x = mx; e.mouse.y = my;
+			if (holdLeft) {
+				e.type = Common::EVENT_LBUTTONDOWN; pushEvent(e);
+				holdL = true;
+			} else {
+				e.type = Common::EVENT_RBUTTONDOWN; pushEvent(e);
+				e.type = Common::EVENT_RBUTTONUP; pushEvent(e);
+			}
+			rcDone = true;
+		}
+		// escape hatch: hold the top-left corner for 2.5s to quit ScummVM
+		if (nBeat < 25 && GetTickCount() - tBeat >= 3000) {      // heartbeat: is the touch path alive?
+			char hb[120]; nBeat++; tBeat = GetTickCount();
+			sprintf(hb, "touch beat: records=%d head=+%lx drain=%d frozen=%d\n", nTouch, head - base, (int)drain, g_nfrozen);
+			zlog(hb);
+			DWORD cw[24];                              // ci3 control structure: what does the input service think?
+			if (ReadProcessMemory(h, (void *)ZAM_CI3, cw, sizeof cw, &rd)) {
+				char b2[300]; int n2 = sprintf(b2, "  ci3:");
+				for (int i = 0; i < 24; i++) n2 += sprintf(b2 + n2, " %lx", cw[i]);
+				strcat(b2, "\n"); zlog(b2);
+			}
+		}
+		if (!nTouch && GetTickCount() - tStart > 120000) {         // safety net: touch never worked -> do not trap the user
+			zlog("touch: no input for 120s, quitting\n");
+			g_quit = true;
+		}
+		if (down && zone == 2 && GetTickCount() - tDown > 2500)
+			g_quit = true;
+		Sleep(2);
+	}
+	CloseHandle(h);
+}
+
+// Touch through OpenZDK's input API (replaces the servicesd ring reader).
+void OSystem_Zune::touchLoop() {
+	if (zdkLoad() && g_zcfg.ring) { touchLoopRing(); return; }
+	if (!zdkLoad() || !g_zdk.inInit || !g_zdk.inGetState) { zlog("zdk: input unavailable\n"); return; }
+	LONG ir = g_zdk.inInit();
+	{ char lb[80]; sprintf(lb, "zdk: input init=%lx\n", ir); zlog(lb); }
+	if (g_zcfg.noinput) { zlog("zdk: input polling disabled\n"); while (!g_quit) Sleep(50); return; }
+	bool down = false, dragging = false, rcDone = false, holdL = false, wasTouch = false;
+	int nTouch = 0, nlog = 0;
+	int zone = 0;                            // 1 = top-right (Esc), 2 = top-left (menu / hold to quit), 3 = bottom-right (right click)
+	const int ZONE_W = 56, ZONE_H = 44;
+	int dx = 0, dy = 0, lx = 0, ly = 0;      // down point and last point (landscape)
+	DWORD tDown = 0, tStart = GetTickCount();
+
+	while (!g_quit) {
+		ZdkInputState st;
+		memset(&st, 0, sizeof st);
+		int ph = 0, c = 0;
+		if (g_zdk.inGetState(&st) >= 0) {
+			bool t = st.count > 0;
+			if (t) {
+				float fx = st.loc[0].x, fy = st.loc[0].y;
+				if (g_zcfg.touchnorm) { fx *= 272.0f; fy *= 480.0f; }
+				int px = (int)fx, py = (int)fy;      // portrait touch
+				if (g_zcfg.touchswap) { int tmp = px; px = py; py = tmp; }
+				lx = py; ly = (ZuneGraphicsManager::LAND_H - 1) - px;   // rotate portrait touch -> landscape
+				if (lx < 0) lx = 0; if (lx >= ZuneGraphicsManager::LAND_W) lx = ZuneGraphicsManager::LAND_W - 1;
+				if (ly < 0) ly = 0; if (ly >= ZuneGraphicsManager::LAND_H) ly = ZuneGraphicsManager::LAND_H - 1;
+				if (nlog < 40 && (nlog < 8 || !wasTouch)) { nlog++; char lb[120]; sprintf(lb, "zdk: touch n=%d x=%.1f y=%.1f p=%.2f -> l=%d,%d\n", st.count, st.loc[0].x, st.loc[0].y, st.loc[0].pressure, lx, ly); zlog(lb); }
+			}
+			if (t && !wasTouch) { ph = 1; c = 1; }
+			else if (!t && wasTouch) { ph = 1; c = 0; }
+			else if (t) ph = 3;
+			wasTouch = t;
+		}
+		if (ph) {
+			nTouch++;
+				Common::Event e;
+				int mx, my;
+				if (ph == 1 && c == 1) {
+					down = true; dragging = false; rcDone = false; dx = lx; dy = ly; tDown = GetTickCount();
+					// corner zones are on-screen buttons, not game input
+					zone = (ly < ZONE_H && lx >= ZuneGraphicsManager::LAND_W - ZONE_W) ? 1 : (ly < ZONE_H && lx < ZONE_W) ? 2
+						: (ly >= ZuneGraphicsManager::LAND_H - ZONE_H && lx >= ZuneGraphicsManager::LAND_W - ZONE_W) ? 3 : 0;   // 3 = bottom-right: right click (CMI inventory)
+					if (!zone) {
+						gfx()->landscapeToMouse(lx, ly, mx, my);
+						e.type = Common::EVENT_MOUSEMOVE; e.mouse.x = mx; e.mouse.y = my; pushEvent(e);
+						gfx()->setMouse(mx, my);
+					}
+				} else if (ph == 1 && c == 0 && down && zone) {
+					// zone tap (short press): top-right = Esc (skip cutscene), top-left = global menu (Ctrl+F5)
+					if (GetTickCount() - tDown < 1500) {
+						if (zone == 1) pushKey(Common::KEYCODE_ESCAPE, 27, 0);
+						else if (zone == 3) {
+							gfx()->landscapeToMouse(lx, ly, mx, my);
+							e.mouse.x = mx; e.mouse.y = my;
+							e.type = Common::EVENT_RBUTTONDOWN; pushEvent(e);
+							e.type = Common::EVENT_RBUTTONUP; pushEvent(e);
+						} else pushKey(Common::KEYCODE_F5, 0, Common::KBD_CTRL);
+					}
+					zone = 0; down = false;
+				} else if (ph == 1 && c == 0 && down) {
+					gfx()->landscapeToMouse(lx, ly, mx, my);
+					if (holdL) {                        // end of a held left button: release where the finger is
+						e.mouse.x = mx; e.mouse.y = my; e.type = Common::EVENT_LBUTTONUP; pushEvent(e);
+						holdL = false;
+					} else if (!dragging && !rcDone) {        // a tap: click now
+						e.mouse.x = mx; e.mouse.y = my;
+						e.type = Common::EVENT_LBUTTONDOWN; pushEvent(e);
+						e.type = Common::EVENT_LBUTTONUP; pushEvent(e);
+					} else if (dragging) {
+						e.mouse.x = mx; e.mouse.y = my; e.type = Common::EVENT_LBUTTONUP; pushEvent(e);
+					}
+					down = false;
+				} else if (ph == 3 && down && !zone) {
+					gfx()->landscapeToMouse(lx, ly, mx, my);
+					if (!dragging && !rcDone && (abs(lx - dx) > 12 || abs(ly - dy) > 12)) {
+						dragging = true;
+						int ox, oy; gfx()->landscapeToMouse(dx, dy, ox, oy);
+						e.mouse.x = ox; e.mouse.y = oy; e.type = Common::EVENT_LBUTTONDOWN; pushEvent(e);
+					}
+					e.type = Common::EVENT_MOUSEMOVE; e.mouse.x = mx; e.mouse.y = my; pushEvent(e);
+					gfx()->setMouse(mx, my);
+				}
+		}
+		// long press without movement
+		bool holdLeft = ConfMan.hasKey("gameid") && ConfMan.get("gameid") == "comi";   // CMI: hold = left button down
+		if (down && !zone && !dragging && !rcDone && GetTickCount() - tDown > (holdLeft ? 450 : 700)) {
+			int mx, my; gfx()->landscapeToMouse(lx, ly, mx, my);
+			Common::Event e; e.mouse.x = mx; e.mouse.y = my;
+			if (holdLeft) {
+				e.type = Common::EVENT_LBUTTONDOWN; pushEvent(e);
+				holdL = true;
+			} else {
+				e.type = Common::EVENT_RBUTTONDOWN; pushEvent(e);
+				e.type = Common::EVENT_RBUTTONUP; pushEvent(e);
+			}
+			rcDone = true;
+		}
+		if (!nTouch && GetTickCount() - tStart > 120000) {         // safety net: touch never worked -> do not trap the user
+			zlog("touch: no input for 120s, quitting\n");
+			g_quit = true;
+		}
+		if (down && zone == 2 && GetTickCount() - tDown > 2500)   // escape hatch: hold the top-left corner
+			g_quit = true;
+		Sleep(8);
+	}
+	if (g_zdk.inShutdown) g_zdk.inShutdown();
+}
+
+// ---- entry points -----------------------------------------------------------------------------
+static char g_args[600];
+
+static volatile bool g_running = false;
+
+static void *scummMain(void *) {
+	g_zdk.h = NULL; zdkLoad();   // re-read zdk.ini on every launch (the daemon keeps this DLL loaded between launches)
+	g_quit = false;
+	g_running = true;
+	// args: "gameid|path" starts that game directly; empty or "launcher" opens ScummVM's game list instead.
+	// Either way the config lists Day of the Tentacle so it can be picked from the launcher.
+	char gameid[64] = "tentacle", path[500] = "\\flash2\\scummvm\\games\\tentacle";
+	bool autostart = false;
+	char *bar = strchr(g_args, '|');
+	if (g_args[0] && strncmp(g_args, "launcher", 8) != 0) {
+		autostart = true;
+		if (bar) { *bar = 0; strncpy(gameid, g_args, 63); strncpy(path, bar + 1, 499); }
+		else strncpy(gameid, g_args, 63);
+	}
+	CreateDirectoryW(L"\\flash2\\scummvm", NULL);
+	CreateDirectoryW(L"\\flash2\\scummvm\\saves", NULL);
+	HANDLE f = CreateFileW(L"\\flash2\\scummvm\\scummvm.ini", GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+	if (f != INVALID_HANDLE_VALUE) {
+		// Every game whose data is present under games\<id>\ shows up in the launcher.
+		char ini[8192];
+		int n = sprintf(ini, "[scummvm]\nsavepath=\\flash2\\scummvm\\saves\nmusic_driver=adlib\n\n");
+		bool listed = false;
+		// Every folder under games is a ScummVM game id (the PC loader names them that way); each shows up in the launcher.
+		WIN32_FIND_DATAW fd;
+		HANDLE hf = FindFirstFileW(L"\\flash2\\scummvm\\games\\*", &fd);
+		if (hf != INVALID_HANDLE_VALUE) {
+			do {
+				char nm[64];
+				if (!(fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) || fd.cFileName[0] == L'.') continue;
+				if (!WideCharToMultiByte(CP_ACP, 0, fd.cFileName, -1, nm, sizeof nm, NULL, NULL)) continue;
+				if (n > (int)sizeof ini - 400) break;
+				n += sprintf(ini + n, "[%s]\ngameid=%s\npath=\\flash2\\scummvm\\games\\%s\nlanguage=en\n\n", nm, nm, nm);
+				if (!strcmp(nm, gameid)) listed = true;
+			} while (FindNextFileW(hf, &fd));
+			FindClose(hf);
+		}
+		if (autostart && !listed)   // an explicitly requested game outside the scanned list
+			n += sprintf(ini + n, "[%s]\ngameid=%s\npath=%s\nlanguage=en\nplatform=pc\n\n", gameid, gameid, path);
+		DWORD w; WriteFile(f, ini, n, &w, NULL); CloseHandle(f);
+	}
+	static char a0[] = "scummvm", a1[] = "-c", a2[] = "\\flash2\\scummvm\\scummvm.ini";
+	static char *argv[] = { a0, a1, a2, gameid, NULL };
+	zlog("scummvm: starting\n");
+	freezeUi();
+	{ char fm[48]; sprintf(fm, "scummvm: froze %d UI threads\n", g_nfrozen); zlog(fm); }
+	g_system = new OSystem_Zune();
+	int res = scummvm_main(autostart ? 4 : 3, argv);   // argv[3] (the game id) only when autostarting
+	zlog("scummvm: main returned\n");
+	g_quit = true;          // stop the helper threads before their objects go away
+	Sleep(400);
+	zlog("scummvm: helpers stopped\n");
+	thawUi();               // give the Zune UI back first, before anything else can go wrong
+	zlog("scummvm: UI thawed\n");
+	g_system->destroy();
+	g_system = NULL;
+	zlog("scummvm: system destroyed\n");
+	char m[64]; sprintf(m, "scummvm: exited %d\n", res); zlog(m);
+	g_running = false;
+	return (void *)res;
+}
+
+static int runScumm(const void *arg, int arg_len) {
+	memset(g_args, 0, sizeof g_args);
+	if (arg && arg_len > 0) memcpy(g_args, arg, arg_len < 599 ? arg_len : 599);
+	const DWORD SZ = 4u << 20;
+	byte *blk = (byte *)VirtualAlloc(NULL, SZ, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+	if (!blk) return -1;
+	int r = (int)call_on_stack(scummMain, NULL, blk + SZ - 16);
+	VirtualFree(blk, 0, MEM_RELEASE);
+	return r;
+}
+
+static HANDLE g_hinst = NULL;
+
+// Keep this DLL loaded for the life of the process. Unloading would run ScummVM's global C++
+// destructors a second time (ScummVM cleans its singletons itself), which crashed the daemon.
+static void pinSelf() {
+	WCHAR path[MAX_PATH];
+	if (g_hinst && GetModuleFileNameW((HMODULE)g_hinst, path, MAX_PATH)) LoadLibraryW(path);
+}
+
+extern "C" __declspec(dllexport) int RunDaemon(const void *arg, int arg_len, HANDLE stop_event) {
+	g_stop = stop_event;
+	pinSelf();
+	return runScumm(arg, arg_len);
+}
+
+// One-shot entry: starts ScummVM on its own thread and returns at once so the daemon stays usable.
+// Run("stop") quits it; Run("status") reports. Anything else is "gameid|\\path".
+extern "C" __declspec(dllexport) int Run(const void *arg, int arg_len, void *out, int out_max, int *out_used) {
+	const char *m;
+	int rc = 0;
+	if (arg_len >= 4 && !memcmp(arg, "stop", 4)) {
+		g_quit = true; m = "stop requested";
+	} else if (arg_len >= 6 && !memcmp(arg, "status", 6)) {
+		m = g_running ? "running" : "not running";
+	} else if (g_running) {
+		m = "already running"; rc = 1;
+	} else {
+		memset(g_args, 0, sizeof g_args);
+		if (arg && arg_len > 0) memcpy(g_args, arg, arg_len < 599 ? arg_len : 599);
+		if (!g_stop) g_stop = CreateEventW(NULL, TRUE, FALSE, NULL);
+		g_running = true;
+		if (startStackThread(scummMain, NULL, 4u << 20)) m = "started"; else { g_running = false; m = "thread start failed"; rc = -1; }
+	}
+	int n = (int)strlen(m); if (n > out_max) n = out_max;
+	if (out && out_used) { memcpy(out, m, n); *out_used = n; }
+	return rc;
+}
+
+extern "C" BOOL WINAPI DllMain(HANDLE h, DWORD reason, LPVOID) {
+	if (reason == DLL_PROCESS_ATTACH) g_hinst = h;
+	return TRUE;
+}
